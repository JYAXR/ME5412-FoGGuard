{
  "schema": "fogguard.a2.turning.v1",
  "positions": ["ankleL", "back"],
  "sample_rate_hz": 60,
  "window_samples": 120,
  "step_samples": 30,
  "current_label_purity": 0.8,
  "preturn_horizons_s": [0.5, 1.0],
  "preturn_target_band_s": 0.5,
  "n_estimators": 300,
  "min_samples_leaf": 2,
  "random_state": 5412,
  "feature_sets": ["full", "gravity_rotation"],
  "rejection_thresholds": [0.0, 0.4, 0.5, 0.6, 0.7, 0.8],
  "split_file": "config/fog_selected.json",
  "evaluation_partition": "validation",
  "test_policy": "Do not read TEST sensor samples or score TEST labels"
}
